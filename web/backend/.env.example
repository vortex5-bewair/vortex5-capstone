PORT=4000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/<db-name>
SECRET=<random-jwt-signing-secret>
MQTT_USERNAME=<hivemq-cloud-username>
MQTT_PASSWORD=<hivemq-cloud-password>
# Scopes every MQTT topic per environment: <prefix>/<deviceId>/telemetry and
# <prefix>/<deviceId>/cmd. Production and the real ESP32s use `bewair` (the
# default when unset). Staging uses `bewair-staging`, so it can share the same
# broker and credentials without seeing real classroom telemetry or sending
# commands to real devices.
MQTT_TOPIC_PREFIX=bewair
# Brevo (https://brevo.com) — used to email signup verification codes.
# EMAIL_FROM must be a verified sender in Brevo (Senders, Domains & Dedicated
# IPs > Senders) — no domain required, just click the confirmation link
# Brevo emails to that address.
BREVO_API_KEY=<brevo-api-key>
EMAIL_FROM=<verified-sender-email>
# Cloudinary — stores uploaded profile pictures and bulletin-board videos.
# Render's own disk is ephemeral (wiped on every redeploy / cold start), so
# uploads MUST go here or they silently vanish. Without these three vars set,
# every image/video upload fails. Values are on the Cloudinary dashboard
# (Programmable Media > Dashboard > "API Keys").
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

# Optional: set to 1 to enable extra sensor-decoder debug logging
DEBUG_SENSOR=0
